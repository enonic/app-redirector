<content-type>
  <display-name>Redirect Rule</display-name>
  <description>A single redirection instruction</description>
  <super-type>base:structured</super-type>
  <display-name-expression>${source.exact.path}${source.prefix.path}${source.regex.expression} ➔ [${statusCode}] ${target.relative.path}${target.external.url}</display-name-expression>

  <form>
    <option-set name="source">
      <label>Source</label>
      <occurrences minimum="1" maximum="1"/>


      <options minimum="0" maximum="1">

        <option name="prefix">
          <label>Prefix</label>
          <items>
            <input name="path" type="TextLine">
              <label>Path Prefix</label>
              <help-text>Redirects this path and everything under it. e.g., /blog</help-text>
              <occurrences minimum="1" maximum="1"/>
              <config>
                <regexp>^/.*</regexp>
              </config>
            </input>
          </items>
        </option>

        <option name="exact">
          <label>Exact Match</label>
          <items>
            <input name="path" type="TextLine">
              <label>Source Path</label>
              <help-text>e.g., /old-landing-page/path</help-text>
              <occurrences minimum="1" maximum="1"/>
              <config>
                <regexp>^/.*</regexp>
              </config>
            </input>
          </items>
        </option>

        <option name="regex">
          <label>Advanced (Regex)</label>
          <items>
            <input name="expression" type="TextLine">
              <label>Regular Expression</label>
              <help-text>Apache-style regex. e.g., ^/products/(.*)$</help-text>
              <occurrences minimum="1" maximum="1"/>
            </input>
          </items>
        </option>
      </options>
    </option-set>

    <option-set name="target">
      <label>Target</label>
      <occurrences minimum="1" maximum="1"/>
      <options minimum="0" maximum="1">
 
        <option name="reference">
          <label>Content</label>
          <items>
            <input name="content" type="ContentSelector">
              <label>Target item</label>
              <help-text>Always target this item if it is moved or renamed.</help-text>
              <occurrences minimum="0" maximum="1"/>
              <config>
            <allow-content-type>^(?!(portal:fragment|portal:page-template|media:|com\.enonic\.app\.redirector:)).*</allow-content-type>
            <tree-mode>true</tree-mode>
          </config>
            </input>
          </items>
        </option>

        <option name="relative">
          <label>Relative Path</label>
          <items>
            <input name="path" type="TextLine">
              <label>Path</label>
              <help-text>e.g. a relative path with placeholders like $1. Non-ASCII characters must be percent-encoded (e.g. ø → %C3%B8).</help-text>
              <occurrences minimum="1" maximum="1"/>
              <config>
                <regexp>^/.*</regexp>
              </config>
            </input>
          </items>
        </option>

        <option name="external">
          <label>External URL</label>
          <items>
            <input name="url" type="TextLine">
              <label>URL</label>
              <help-text>e.g., https://enonic.com/ with placeholders like $1. Non-ASCII characters must be percent-encoded (e.g. ø → %C3%B8).</help-text>
              <occurrences minimum="1" maximum="1"/>
              <config>
                <regexp>^https?://.*</regexp>
              </config>
            </input>
          </items>
        </option>
      </options>
    </option-set>

    <input name="statusCode" type="ComboBox">
      <label>HTTP Status Code</label>
      <default>301</default>
      <occurrences minimum="1" maximum="1"/>
      <config>
        <option value="301">301 - Permanent Redirect</option>
        <option value="302">302 - Temporary Redirect</option>
        <option value="410">410 - Content Gone</option>
      </config>
    </input>

    <input name="comment" type="TextArea">
      <label>Internal Note</label>
      <help-text>Why was this redirect created?</help-text>
      <occurrences minimum="0" maximum="1"/>
    </input>
  </form>

  <allow-child-content>false</allow-child-content>
</content-type>